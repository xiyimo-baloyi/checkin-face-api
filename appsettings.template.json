{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureFaceApi": {
    "Endpoint": "https://YOUR_RESOURCE_NAME.cognitiveservices.azure.com/",
    "Key": "YOUR_KEY"
  },
  "CosmosDb": {
    "AccountEndpoint": "https://YOUR_ACCOUNT.documents.azure.com:443/",
    "AccountKey": "YOUR_KEY",
    "DatabaseName": "AfricanIdeasDB"
  },
  "AzureStorage": {
    "ConnectionString": "",
    "ContainerName": "faces"
  },
  "Azure": {
    "SignalR": {
      "ConnectionString": "YOUR_CONNECTION_STRING"
    }
  },
  "AdminSettings": {
    "DefaultPassword": "ChangeMe123!",
    "AdminEmail": "admin@africanideas.co.za"
  },
  "LeaveSettings": {
    "ApprovalSigningKey": "CHANGE_ME_LONG_RANDOM_SECRET"
  },
  "WhatsAppSettings": {
    "VerifyToken": "CHANGE_ME",
    "AppSecret": "CHANGE_ME"
  },
  "ApiSettings": {
    "ApiKey": "CHANGE_ME"
  },
  "JwtSettings": {
    "SecretKey": "CHANGE_ME_AT_LEAST_32_CHARACTERS",
    "Issuer": "AfricanIdeasIdentity",
    "Audience": "AfricanIdeasIdentityClient",
    "ExpiryMinutes": "1440"
  }
