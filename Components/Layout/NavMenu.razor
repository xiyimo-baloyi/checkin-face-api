@using Africanideasfaceapi.Services
@using Africanideasfaceapi.Models
@inject AuthService AuthService

<div class="d-flex flex-column gap-3 py-3">
    <!-- Section: My Workspace -->
    <div class="nav-group mb-4">
        <div class="px-4 mb-3 text-uppercase text-white text-opacity-40 fw-bold letter-spacing-wide" style="font-size: 0.65rem;">
            My Workspace
        </div>
        <nav class="nav flex-column gap-1 px-2">
            <div class="nav-item">
                <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="" Match="NavLinkMatch.All">
                    <i class="bi bi-grid-fill opacity-75"></i>
                    <span class="ms-1">Dashboard</span>
                </NavLink>
            </div>
            
            @if (isAuthenticated)
            {
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="notifications">
                        <i class="bi bi-bell-fill opacity-75"></i>
                        <span class="ms-1">Activity Alerts</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="profile">
                        <i class="bi bi-person-badge-fill opacity-75"></i>
                        <span class="ms-1">My Profile</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="attendance-history">
                        <i class="bi bi-calendar-check opacity-75"></i>
                        <span class="ms-1">Attendance Log</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="worker/request-remote">
                        <i class="bi bi-laptop-fill opacity-75"></i>
                        <span class="ms-1">Remote Request</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="leave">
                        <i class="bi bi-airplane-engines-fill opacity-75"></i>
                        <span class="ms-1">Request Leave</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="compliance/consent">
                        <i class="bi bi-shield-check opacity-75"></i>
                        <span class="ms-1">Compliance Hub</span>
                    </NavLink>
                </div>
            }
        </nav>
    </div>

    <!-- Section: Administration -->
    @if (isAdmin)
    {
        <div class="nav-group mb-4 animate-fade-in" style="animation-delay: 0.1s;">
            <div class="px-4 mb-3 text-uppercase text-white text-opacity-40 fw-bold letter-spacing-wide" style="font-size: 0.65rem;">
                People & Assets
            </div>
            <nav class="nav flex-column gap-1 px-2">
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="/admin/staff">
                        <i class="bi bi-people-fill opacity-75"></i>
                        <span class="ms-1">Staff Directory</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="/admin/branches">
                        <i class="bi bi-buildings-fill opacity-75"></i>
                        <span class="ms-1">Branch Registry</span>
                    </NavLink>
                </div>
            </nav>
        </div>

        <div class="nav-group mb-4 animate-fade-in" style="animation-delay: 0.15s;">
            <div class="px-4 mb-3 text-uppercase text-white text-opacity-40 fw-bold letter-spacing-wide" style="font-size: 0.65rem;">
                Operations
            </div>
            <nav class="nav flex-column gap-1 px-2">
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="/admin/leave">
                        <i class="bi bi-calendar-check-fill opacity-75"></i>
                        <span class="ms-1">Leave Approvals</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="/admin/absences">
                         <i class="bi bi-exclamation-octagon-fill opacity-75"></i>
                        <span class="ms-1">Absence Logs</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="/admin/corrections">
                         <i class="bi bi-clock-history opacity-75"></i>
                        <span class="ms-1">Correction Req.</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="/admin/remote-requests">
                         <i class="bi bi-laptop opacity-75"></i>
                        <span class="ms-1">Remote Approvals</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="/field-attendance">
                         <i class="bi bi-camera-fill opacity-75"></i>
                        <span class="ms-1">Field Attendance</span>
                    </NavLink>
                </div>
            </nav>
        </div>

        <div class="nav-group mb-4 animate-fade-in" style="animation-delay: 0.2s;">
            <div class="px-4 mb-3 text-uppercase text-white text-opacity-40 fw-bold letter-spacing-wide" style="font-size: 0.65rem;">
                Intelligence
            </div>
            <nav class="nav flex-column gap-1 px-2">
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="/admin/analytics">
                        <i class="bi bi-graph-up-arrow opacity-75"></i>
                        <span class="ms-1">Intelligence Hub</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="/admin/deep-analytics">
                        <i class="bi bi-cpu-fill opacity-75"></i>
                        <span class="ms-1">Deep Analytics</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="/admin/map">
                        <i class="bi bi-geo-alt-fill opacity-75"></i>
                        <span class="ms-1">Live Geography</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="/admin/reports">
                        <i class="bi bi-file-earmark-spreadsheet-fill opacity-75"></i>
                        <span class="ms-1">Export Reports</span>
                    </NavLink>
                </div>
            </nav>
        </div>

        <div class="nav-group mb-4 animate-fade-in" style="animation-delay: 0.25s;">
            <div class="px-4 mb-3 text-uppercase text-white text-opacity-40 fw-bold letter-spacing-wide" style="font-size: 0.65rem;">
                Security & System
            </div>
            <nav class="nav flex-column gap-1 px-2">
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="/admin/whatsapp">
                        <i class="bi bi-whatsapp opacity-75"></i>
                        <span class="ms-1">Comm. Hub (WA)</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="/admin/audit">
                        <i class="bi bi-shield-lock-fill opacity-75"></i>
                        <span class="ms-1">Security Logs</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="/admin/settings">
                        <i class="bi bi-gear-fill opacity-75"></i>
                        <span class="ms-1">System Settings</span>
                    </NavLink>
                </div>
            </nav>
        </div>
    }

    <!-- Section: Account -->
    <div class="nav-group mt-auto mb-2">
        <div class="px-4 mb-3 text-uppercase text-white text-opacity-40 fw-bold letter-spacing-wide" style="font-size: 0.65rem;">
            Account
        </div>
        <nav class="nav flex-column gap-1 px-2">
            @if (!isAuthenticated)
            {
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="login">
                        <i class="bi bi-box-arrow-in-right opacity-75"></i>
                        <span class="ms-1">Staff Login</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link px-3 py-2 rounded-3 transition-all" href="register">
                        <i class="bi bi-person-plus opacity-75"></i>
                        <span class="ms-1">New Enrollment</span>
                    </NavLink>
                </div>
            }
            else
            {
                <div class="nav-item">
                    <button class="nav-link w-100 text-start border-0 bg-transparent px-3 py-2 rounded-3 transition-all hover-translate-y" @onclick="HandleLogout">
                        <i class="bi bi-box-arrow-right text-danger"></i>
                        <span class="text-danger ms-1 fw-bold">Sign Out</span>
                    </button>
                </div>
            }
        </nav>
    </div>
</div>

@code {
    private bool isAuthenticated;
    private bool isAdmin;
    private User? currentUser;

    protected override void OnInitialized()
    {
        LoadState();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            LoadState();
            StateHasChanged();
        }
    }

    private void LoadState()
    {
        try
        {
            isAuthenticated = AuthService.IsAuthenticated;
            isAdmin = AuthService.IsAdmin;
            currentUser = AuthService.CurrentUser;
        }
        catch
        {
            isAuthenticated = false;
            isAdmin = false;
            currentUser = null;
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        // Force refresh to clear state
        NavigationManager.NavigateTo("/login", true);
    }

    [Inject] NavigationManager NavigationManager { get; set; } = default!;
}
