@page "/admin/analytics"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@using Africanideasfaceapi.Services
@using Africanideasfaceapi.Models
@inject AnalyticsService AnalyticsService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Analytics - African Ideas Attendance</PageTitle>

@if (isLoading)
{
    <div class="container mt-5 text-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (!isAuthenticated || !isAdmin)
{
    <div class="container mt-5">
        <div class="alert alert-danger">
            <h4>Access Denied</h4>
            <p>You must be an admin to access this page.</p>
            <a href="/login" class="btn btn-primary">Go to Login</a>
        </div>
    </div>
}
else
{
    <div class="container-fluid mt-4 animate-fade-in pb-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
        <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-3 w-100 w-md-auto">
            <div class="bg-white rounded-circle p-1 d-flex align-items-center justify-content-center shadow-sm d-none d-md-flex" style="width: 50px; height: 50px;">
                <img src="/images/african-ideas-logo.png" alt="Logo" class="w-100" />
            </div>
            <div>
                <h2 class="fw-bold mb-1 text-primary mobile-h2">Intelligence Hub</h2>
                <p class="text-muted mb-0 small mobile-d-none">System-wide performance metrics and biometric health tracking.</p>
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center w-100 w-md-auto justify-content-between justify-content-md-end">
            <div class="glass-panel p-2 rounded-pill d-flex align-items-center shadow-sm flex-grow-1 flex-md-grow-0 justify-content-between">
                <span class="text-muted px-2 px-md-3 small fw-bold text-uppercase letter-spacing-wide d-none d-md-inline">Range:</span>
                <select class="form-select border-0 bg-transparent fw-bold text-primary py-0 text-center text-md-start w-100 w-md-auto" @bind="selectedTimeframe" @bind:after="RefreshData" style="cursor: pointer; font-size: 0.85rem;">
                    <option value="7">Last 7 Days</option>
                    <option value="30">Last 30 Days</option>
                    <option value="90">Last 90 Days</option>
                </select>
            </div>
            <button class="btn btn-white shadow-sm rounded-circle p-2 transition-all hover-translate-y flex-shrink-0" @onclick="RefreshData" disabled="@isLoading" title="Refresh Analytics">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise text-primary"></i>
                }
            </button>
        </div>
    </div>

    @if (actionableInsights != null && actionableInsights.HasIssues)
    {
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-warning bg-opacity-10 border-0 p-3">
                        <h5 class="mb-0 fw-bold text-dark d-flex align-items-center">
                            <i class="bi bi-lightning-charge-fill text-warning me-2"></i> Action Center
                            <span class="badge bg-warning text-dark ms-2 rounded-pill shadow-sm" style="font-size: 0.75rem;">Attention Required</span>
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="row g-0">
                            @if (actionableInsights.PendingUserApprovals > 0)
                            {
                                <div class="col-6 col-md-3 border-end">
                                    <div class="p-3 p-md-4 text-center hover-bg transition-all cursor-pointer" @onclick='() => Navigation.NavigateTo("/admin/staff")'>
                                        <h3 class="fw-bold text-primary mb-1">@actionableInsights.PendingUserApprovals</h3>
                                        <p class="text-muted small mb-0">Pending Approvals</p>
                                    </div>
                                </div>
                            }
                            @if (actionableInsights.PendingAbsenceReviews > 0)
                            {
                                <div class="col-6 col-md-3 border-end">
                                    <div class="p-3 p-md-4 text-center hover-bg transition-all cursor-pointer" @onclick='() => SetActiveTab("attendance")'>
                                        <h3 class="fw-bold text-danger mb-1">@actionableInsights.PendingAbsenceReviews</h3>
                                        <p class="text-muted small mb-0">Pending Absences</p>
                                    </div>
                                </div>
                            }
                            @if (actionableInsights.GeofenceViolationsToday > 0)
                            {
                                <div class="col-6 col-md-3 border-end">
                                    <div class="p-3 p-md-4 text-center hover-bg transition-all cursor-pointer" @onclick='() => SetActiveTab("activity")'>
                                        <h3 class="fw-bold text-warning mb-1">@actionableInsights.GeofenceViolationsToday</h3>
                                        <p class="text-muted small mb-0">Geofence Violations</p>
                                    </div>
                                </div>
                            }
                            @if (actionableInsights.CriticalBiometricFailures > 0)
                            {
                                <div class="col-6 col-md-3">
                                    <div class="p-3 p-md-4 text-center hover-bg transition-all cursor-pointer" @onclick='() => Navigation.NavigateTo("/admin/deep-analytics")'>
                                        <h3 class="fw-bold text-dark mb-1">@actionableInsights.CriticalBiometricFailures</h3>
                                        <p class="text-muted small mb-0">High-Risk Failures</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (stats != null)
    {
        <!-- Intelligence Summary Card -->
        <div class="glass-panel p-3 p-md-4 rounded-4 shadow-lg mb-4 border-0 position-relative overflow-hidden" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);">
            <div class="position-absolute top-0 end-0 p-3 opacity-10">
                <i class="bi bi-cpu-fill fs-1 text-white"></i>
            </div>
            <div class="row align-items-center g-3">
                <div class="col-12 col-md-8 text-center text-md-start">
                    <h5 class="text-white text-uppercase small fw-bold mb-2 letter-spacing-wide">Overall System Performance</h5>
                    <h1 class="fw-bold text-white mb-2 mobile-display-3" style="font-size: 3.5rem;">@stats.LoginSuccessRate.ToString("F0")<span class="fs-4">%</span></h1>
                    <p class="text-white text-opacity-75 mb-0 small">Success rate across @stats.RegistrationsInRange new enrollments this period.</p>
                </div>
                <div class="col-12 col-md-4 text-center text-md-end">
                    <div class="progress bg-white bg-opacity-20 rounded-pill mb-3" style="height: 12px;">
                        <div class="progress-bar bg-white shadow-sm" role="progressbar" style="width: @stats.LoginSuccessRate%" aria-valuenow="@stats.LoginSuccessRate" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <button class="btn btn-white btn-sm px-4 rounded-pill fw-bold text-primary shadow-sm" @onclick='() => Navigation.NavigateTo("/admin/deep-analytics")'>
                        View Deep Insights <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- KPI Cards -->
        <div class="row g-3 g-md-4 mb-4">
            <div class="col-6 col-md-3">
                <div class="glass-panel p-3 p-md-4 rounded-4 shadow-sm border-0 h-100 position-relative overflow-hidden transition-all hover-translate-y">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-people-fill text-primary" style="font-size: 0.9rem;"></i>
                        </div>
                        <h6 class="text-muted text-uppercase small fw-bold mb-0" style="font-size: 0.65rem;">Registry</h6>
                    </div>
                    <h3 class="fw-bold text-dark mb-0 ms-1">@stats.TotalWorkers</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="glass-panel p-3 p-md-4 rounded-4 shadow-sm border-0 h-100 position-relative overflow-hidden transition-all hover-translate-y border-bottom border-4 border-success">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="rounded-circle bg-success bg-opacity-10 p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-person-plus-fill text-success" style="font-size: 0.9rem;"></i>
                        </div>
                        <h6 class="text-muted text-uppercase small fw-bold mb-0" style="font-size: 0.65rem;">Growth</h6>
                    </div>
                    <h3 class="fw-bold text-success mb-0 ms-1">+@stats.RegistrationsInRange</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="glass-panel p-3 p-md-4 rounded-4 shadow-sm border-0 h-100 position-relative overflow-hidden transition-all hover-translate-y border-bottom border-4 border-warning">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-clock-history text-warning" style="font-size: 0.9rem;"></i>
                        </div>
                        <h6 class="text-muted text-uppercase small fw-bold mb-0" style="font-size: 0.65rem;">Pending</h6>
                    </div>
                    <h3 class="fw-bold text-warning mb-0 ms-1">@stats.PendingApprovals</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="glass-panel p-3 p-md-4 rounded-4 shadow-sm border-0 h-100 position-relative overflow-hidden transition-all hover-translate-y border-bottom border-4 border-info">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="rounded-circle bg-info bg-opacity-10 p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-shield-check text-info" style="font-size: 0.9rem;"></i>
                        </div>
                        <h6 class="text-muted text-uppercase small fw-bold mb-0" style="font-size: 0.65rem;">Health</h6>
                    </div>
                    <h3 class="fw-bold text-info mb-0 ms-1">@stats.LoginSuccessRate.ToString("F0")%</h3>
                </div>
            </div>
        </div>

        <!-- Tabbed Navigation -->
        <div class="glass-panel p-0 rounded-4 shadow-sm border-0 overflow-hidden mb-4">
            <div class="p-2 border-bottom border-light bg-primary bg-opacity-5">
                <ul class="nav nav-pills gap-2 flex-nowrap overflow-auto pb-1 mobile-scroll-x" id="pills-tab" role="tablist">
                    <li class="nav-item flex-shrink-0">
                        <button class="nav-link rounded-pill fw-bold @(activeTab == "overview" ? "active" : "")" @onclick='() => SetActiveTab("overview")'>
                            <i class="bi bi-graph-up me-2"></i>Trends
                        </button>
                    </li>
                    <li class="nav-item flex-shrink-0">
                        <button class="nav-link rounded-pill fw-bold @(activeTab == "attendance" ? "active" : "")" @onclick='() => SetActiveTab("attendance")'>
                            <i class="bi bi-calendar-check me-2"></i>Daily Log
                        </button>
                    </li>
                    <li class="nav-item flex-shrink-0">
                        <button class="nav-link rounded-pill fw-bold @(activeTab == "branches" ? "active" : "")" @onclick='() => SetActiveTab("branches")'>
                            <i class="bi bi-geo-alt me-2"></i>Regional
                        </button>
                    </li>
                    <li class="nav-item flex-shrink-0">
                        <button class="nav-link rounded-pill fw-bold @(activeTab == "activity" ? "active" : "")" @onclick='() => SetActiveTab("activity")'>
                            <i class="bi bi-activity me-2"></i>Security
                        </button>
                    </li>
                </ul>
            </div>
            <div class="p-4">
                    @if (activeTab == "overview")
                    {
                        <div class="row g-4">
                            <div class="col-lg-8">
                                <h5 class="fw-bold text-primary mb-4 d-flex align-items-center">
                                    <i class="bi bi-graph-up me-2"></i> Registration Trends
                                </h5>
                                <div class="bg-white rounded-4 shadow-inner p-3 overflow-hidden" style="height: 320px; position: relative;">
                                    <canvas id="registrationTrendChart"></canvas>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <h5 class="fw-bold text-primary mb-4 d-flex align-items-center">
                                    <i class="bi bi-pie-chart-fill me-2"></i> Enrollment split
                                </h5>
                                <div class="glass-panel p-4 rounded-4 bg-white shadow-sm mb-4">
                                    <div class="mb-4">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted fw-bold">Face Recognition</span>
                                            <span class="text-primary fw-bold">@stats.FaceRegistered</span>
                                        </div>
                                        <div class="progress rounded-pill" style="height: 10px;">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: @(stats.TotalWorkers > 0 ? (double)stats.FaceRegistered / stats.TotalWorkers * 100 : 0)%" 
                                                 aria-valuenow="@(stats.TotalWorkers > 0 ? (double)stats.FaceRegistered / stats.TotalWorkers * 100 : 0)" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                    <div class="mb-2">
                                        <div class="d-flex justify-content-between mb-2">
                                            <span class="text-muted fw-bold">Document Enrollment</span>
                                            <span class="text-info fw-bold">@stats.DocumentRegistered</span>
                                        </div>
                                        <div class="progress rounded-pill" style="height: 10px;">
                                            <div class="progress-bar bg-info" role="progressbar" style="width: @(stats.TotalWorkers > 0 ? (double)stats.DocumentRegistered / stats.TotalWorkers * 100 : 0)%"
                                                 aria-valuenow="@(stats.TotalWorkers > 0 ? (double)stats.DocumentRegistered / stats.TotalWorkers * 100 : 0)" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                </div>
                                
                                <h6 class="text-muted text-uppercase small fw-bold mb-3">Key Performance Indicators</h6>
                                <div class="list-group list-group-flush border-top border-light">
                                    <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3 bg-transparent">
                                        <span>Period Growth</span>
                                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">+@stats.RegistrationsInRange</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3 bg-transparent">
                                        <span>Compliance Status</span>
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">@((stats.TotalWorkers > 0 ? (double)stats.WithConsent / stats.TotalWorkers * 100 : 0).ToString("F1"))% Concented</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (activeTab == "attendance" && dailyAttendance != null)
                    {
                        <div class="row g-4">
                            <div class="col-md-3">
                                <div class="glass-panel p-4 rounded-4 text-center bg-white shadow-sm border-start border-4 border-success">
                                    <h6 class="text-muted text-uppercase small fw-bold mb-2">Present Today</h6>
                                    <h2 class="fw-bold text-success mb-1">@dailyAttendance.PresentCount</h2>
                                    <p class="text-muted small mb-0">of @dailyAttendance.TotalEmployees active employees</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="glass-panel p-4 rounded-4 text-center bg-white shadow-sm border-start border-4 border-danger">
                                    <h6 class="text-muted text-uppercase small fw-bold mb-2">Absences</h6>
                                    <h2 class="fw-bold text-danger mb-1">@dailyAttendance.AbsenceCount</h2>
                                    <p class="text-muted small mb-0">Includes unapproved & reported</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="glass-panel p-4 rounded-4 text-center bg-white shadow-sm border-start border-4 border-warning">
                                    <h6 class="text-muted text-uppercase small fw-bold mb-2">Overtime Today</h6>
                                    <h2 class="fw-bold text-warning mb-1">@dailyAttendance.TotalOvertimeHours.ToString("F1")h</h2>
                                    <p class="text-muted small mb-0">Across @dailyAttendance.OvertimeCount workers</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="glass-panel p-4 rounded-4 text-center bg-white shadow-sm border-start border-4 border-primary">
                                    <h6 class="text-muted text-uppercase small fw-bold mb-2">Attendance Rate</h6>
                                    <h2 class="fw-bold text-primary mb-1">@dailyAttendance.AttendanceRate.ToString("F1")%</h2>
                                    <p class="text-muted small mb-0">System performance average</p>
                                </div>
                            </div>
                            <div class="col-12 mt-2">
                                <div class="alert alert-warning border-0 bg-warning bg-opacity-10 rounded-4 d-flex align-items-center p-4">
                                    <div class="fs-1 me-4">
                                        <i class="bi bi-geo-alt-fill text-warning"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">Out of Area Alerts</h6>
                                        <p class="mb-0"><strong>@dailyAttendance.OutOfAreaCount</strong> workers clocked in from non-registered locations today. This may require verification.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (activeTab == "branches" && branchData != null)
                    {
                        <div class="table-responsive rounded-3 overflow-hidden">
                            <table class="table table-mobile-cards table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4 fw-bold">Branch Name</th>
                                        <th>Worker Distribution</th>
                                        <th class="text-end pe-4">Team Size</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var branch in branchData)
                                    {
                                        <tr>
                                            <td class="ps-4" data-label="Branch">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2">
                                                        <i class="bi bi-building" aria-hidden="true"></i>
                                                    </div>
                                                    <span class="fw-bold">@branch.BranchName</span>
                                                </div>
                                            </td>
                                            <td style="width: 40%" data-label="Distribution">
                                                <div class="progress rounded-pill shadow-sm" style="height: 10px;">
                                                    <div class="progress-bar bg-gradient-brand" style="width: @(stats.TotalWorkers > 0 ? (double)branch.WorkerCount / stats.TotalWorkers * 100 : 0)%"></div>
                                                </div>
                                            </td>
                                            <td class="text-end pe-4 fw-bold" data-label="Team Size">@branch.WorkerCount</td>
                                        </tr>
                                    }
                                    @if (!branchData.Any())
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center text-muted py-5">
                                                <i class="bi bi-geo fs-1 d-block mb-3 opacity-25"></i>
                                                No branch distribution data available.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (activeTab == "activity" && recentActivity != null)
                    {
                        <div class="timeline p-2">
                            @foreach (var log in recentActivity)
                            {
                                <div class="d-flex gap-3 mb-4 last-child-mb-0">
                                    <div class="text-center" style="min-width: 60px;">
                                        <div class="rounded-4 bg-white shadow-sm p-2 border border-light">
                                            <div class="text-muted small fw-bold mb-1">@log.Timestamp.ToString("MMM")</div>
                                            <div class="fs-5 fw-bold text-primary">@log.Timestamp.ToString("dd")</div>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 glass-panel p-3 rounded-4 shadow-sm bg-white bg-opacity-50">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <span class="badge @(log.Result == "Success" ? "bg-success" : "bg-danger") bg-opacity-10 @(log.Result == "Success" ? "text-success" : "text-danger") rounded-pill px-3 mb-1">
                                                    @log.ActionType
                                                </span>
                                                <h6 class="fw-bold text-dark mb-0">@log.Email</h6>
                                            </div>
                                            <span class="text-muted small">@log.Timestamp.ToString("HH:mm")</span>
                                        </div>
                                        <p class="mb-0 small text-muted">Result: <span class="fw-bold text-@(log.Result == "Success" ? "success" : "danger")">@log.Result</span></p>
                                        @if (!string.IsNullOrEmpty(log.ErrorMessage))
                                        {
                                            <div class="mt-2 p-2 bg-danger bg-opacity-10 text-danger rounded-3 small border border-danger border-opacity-10">
                                                <i class="bi bi-exclamation-circle me-1"></i> @log.ErrorMessage
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Detailed Trends Table -->
            @if (trends != null && trends.Any())
            {
                <div class="glass-panel p-0 rounded-4 shadow-sm border-0 overflow-hidden">
                    <div class="p-4 border-bottom border-light">
                        <h5 class="mb-0 fw-bold text-primary">Registration History <small class="text-muted fw-normal ms-2">(Last 10 Records)</small></h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light bg-opacity-50 text-uppercase small letter-spacing-wide">
                                <tr>
                                    <th class="ps-4">Date</th>
                                    <th>Total Enrollments</th>
                                    <th>Biometric (Face)</th>
                                    <th>Document Based</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var trend in trends.OrderByDescending(t => t.Date).Take(10))
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-dark">@trend.Date.ToString("ddd, dd MMM yyyy")</td>
                                        <td>
                                            <span class="badge bg-primary rounded-pill px-3">@trend.Count</span>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-person-check-fill text-primary"></i>
                                                <span>@trend.FaceCount</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-file-earmark-arrow-up text-info"></i>
                                                <span>@trend.DocumentCount</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Error:</strong> @errorMessage
                <button type="button" class="btn-close" @onclick="() => { errorMessage = null; StateHasChanged(); }" aria-label="Close"></button>
                <div class="mt-2">
                    <button class="btn btn-sm btn-primary" @onclick="RefreshData">Try Again</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool isLoading = true;
    private bool isAuthenticated;
    private bool isAdmin;
    private string activeTab = "overview";
    private int selectedTimeframe = 30;
    
    private DashboardStats? stats;
    private List<RegistrationTrend>? trends;
    private List<AuditLog>? recentActivity;
    private List<BranchDistribution>? branchData;
    private AttendanceStats? dailyAttendance;
    private FaceAccuracyStats? faceAccuracy;
    private ActionableInsights? actionableInsights;
    
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            CheckAuth();
            if (isAuthenticated && isAdmin)
            {
                await LoadAnalytics();
            }
        }
    }

    private void CheckAuth()
    {
        isAuthenticated = AuthService.IsAuthenticated;
        isAdmin = AuthService.IsAdmin;
        if (!isAuthenticated || !isAdmin)
        {
            isLoading = false;
        }
        StateHasChanged();
    }

    private async Task LoadAnalytics()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            // Load all data points for a comprehensive view
            stats = await AnalyticsService.GetDashboardStatsAsync(selectedTimeframe);
            trends = await AnalyticsService.GetRegistrationTrendsAsync(selectedTimeframe);
            recentActivity = await AnalyticsService.GetRecentActivityAsync(10);
            branchData = await AnalyticsService.GetBranchDistributionAsync();
            dailyAttendance = await AnalyticsService.GetDailyAttendanceStatsAsync(DateTime.UtcNow);
            faceAccuracy = await AnalyticsService.GetFaceAccuracyStatsAsync(DateTime.UtcNow.AddDays(-selectedTimeframe), DateTime.UtcNow);
            actionableInsights = await AnalyticsService.GetActionableInsightsAsync();

            isLoading = false;
            StateHasChanged();

            if (activeTab == "overview")
            {
                await RenderCharts();
            }
        }
        catch (Exception ex)
        {
            // Capture full exception details including stack trace
            var errorDetails = $"{ex.GetType().Name}: {ex.Message}";
            if (ex.InnerException != null)
            {
                errorDetails += $"\nInner Exception: {ex.InnerException.Message}";
            }
            errorDetails += $"\nStack Trace: {ex.StackTrace}";
            
            errorMessage = $"Error loading analytics: {errorDetails}";
            Console.WriteLine($"Analytics Load Error: {errorDetails}");
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadAnalytics();
    }

    private async Task UpdateTimeframe()
    {
        await LoadAnalytics();
    }

    private async Task SetActiveTab(string tab)
    {
        activeTab = tab;
        if (tab == "overview")
        {
            // Small delay to ensure canvas is ready
            await Task.Delay(100);
            await RenderCharts();
        }
    }

    private async Task RenderCharts()
    {
        if (trends != null && trends.Any())
        {
            var labels = trends.Select(t => t.Date.ToString("MMM dd")).ToArray();
            var data = trends.Select(t => t.Count).ToArray();
                try
                {
                   await JSRuntime.InvokeVoidAsync("analytics.renderRegistrationChart", "registrationTrendChart", labels, data);
                }
                catch (JSDisconnectedException)
                {
                    // Ignore, page is navigating away
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error rendering chart: {ex.Message}");
                }
        }
    }
}
