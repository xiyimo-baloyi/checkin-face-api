@page "/not-found"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@layout MainLayout

<PageTitle>Page Not Found - African Ideas Attendance</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow text-center">
                <div class="card-body py-5">
                    <h1 class="display-1 text-muted">404</h1>
                    <h2 class="mb-4">Page Not Found</h2>
                    <p class="lead text-muted mb-4">Sorry, the page you are looking for does not exist.</p>
                    <div>
                        <a href="/" class="btn btn-primary me-2">Return to Home</a>
                        <a href="/login" class="btn btn-outline-primary">Go to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
