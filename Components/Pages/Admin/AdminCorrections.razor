@page "/admin/corrections"
@using Africanideasfaceapi.Models
@using Africanideasfaceapi.Services
@inject CorrectionService CorrectionService
@inject AttendanceService AttendanceService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject UserService UserService
@inject IJSRuntime JSRuntime


<PageTitle>Admin: Attendance Corrections - Attendance System</PageTitle>

<div class="container-fluid mt-4 animate-fade-in pb-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
        <div class="d-flex align-items-center gap-3 w-100 w-md-auto">
            <div class="bg-white rounded-circle p-1 d-flex align-items-center justify-content-center shadow-sm d-none d-md-flex" style="width: 50px; height: 50px;">
                <img src="/images/african-ideas-logo.png" alt="Logo" class="w-100" />
            </div>
            <div>
                <h2 class="fw-bold mb-1 text-primary mobile-h2">Attendance Corrections</h2>
                <p class="text-muted mb-0 small mobile-d-none">Review and action employee requests for manual attendance adjustments.</p>
            </div>
        </div>
        <button class="btn btn-white btn-sm rounded-pill px-4 shadow-sm border transition-all hover-translate-y w-100 w-md-auto" @onclick='() => Navigation.NavigateTo("/admin")'>
            <i class="bi bi-grid-fill me-2"></i>Dashboard
        </button>
    </div>

    @if (!string.IsNullOrEmpty(SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @SuccessMessage
            <button type="button" class="btn-close" @onclick="() => SuccessMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @ErrorMessage
            <button type="button" class="btn-close" @onclick="() => ErrorMessage = null"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <div class="spinner-grow text-primary mb-3" role="status"></div>
            <p class="text-muted fw-bold">Loading requests...</p>
        </div>
    }
    else if (pendingRequests == null)
    {
        <div class="glass-panel p-5 text-center rounded-4 border-0 shadow-sm">
            <div class="rounded-circle bg-danger bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                <i class="bi bi-exclamation-triangle text-danger fs-1"></i>
            </div>
            <h4 class="fw-bold">Unable to load requests</h4>
            <p class="text-muted mx-auto" style="max-width: 400px;">The correction queue could not be loaded. Check your connection and refresh the page.</p>
        </div>
    }
    else if (!pendingRequests.Any())
    {
        <div class="glass-panel p-5 text-center rounded-4 border-0 shadow-sm">
            <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                <i class="bi bi-check2-all text-success fs-1"></i>
            </div>
            <h4 class="fw-bold">No Pending Corrections</h4>
            <p class="text-muted mx-auto" style="max-width: 400px;">Great news! All attendance adjustment requests have been processed. Your queue is empty.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var req in pendingRequests)
            {
                var employee = GetEmployee(req.EmployeeId);
                <div class="col-12" @key="req.Id">
                    <div class="glass-panel p-4 rounded-4 shadow-sm border-0 border-start border-4 border-primary position-relative overflow-hidden">
                        <div class="row align-items-center">
                            <div class="col-md-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle border border-2 border-white shadow-sm overflow-hidden" style="width: 54px; height: 54px;">
                                        @if (!string.IsNullOrEmpty(employee?.ImageBase64))
                                        {
                                            <img src="data:image/jpeg;base64,@employee.ImageBase64" alt="Photo" class="w-100 h-100" style="object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="w-100 h-100 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold">
                                                @(employee?.Name?.FirstOrDefault() ?? 'U')
                                            </div>
                                        }
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark">@(employee != null ? $"{employee.Name} {employee.Surname}" : $"User {req.EmployeeId}")</h6>
                                        <div class="badge bg-light text-muted small border mt-1">
                                            Requested: @req.CreatedAt.ToString("dd MMM, HH:mm")
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-5">
                                <div class="p-3 bg-white bg-opacity-50 rounded-4 shadow-inner border border-white">
                                    <div class="d-flex align-items-start gap-2 mb-3">
                                        <i class="bi bi-chat-left-text-fill text-primary opacity-50 mt-1"></i>
                                        <div class="fw-bold text-dark small">Reason: <span class="fw-normal">@req.Reason</span></div>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <div class="text-muted small fw-bold text-uppercase letter-spacing-wide mb-1" style="font-size: 0.65rem;">Clock-In</div>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-box-arrow-in-right text-success"></i>
                                                <span class="@(req.RequestedClockInTime.HasValue ? "text-primary fw-bold" : "text-muted")">
                                                    @(req.RequestedClockInTime?.ToLocalTime().ToString("HH:mm") ?? "No Change")
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-6 border-start border-light ps-3">
                                            <div class="text-muted small fw-bold text-uppercase letter-spacing-wide mb-1" style="font-size: 0.65rem;">Clock-Out</div>
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="bi bi-box-arrow-right text-danger"></i>
                                                <span class="@(req.RequestedClockOutTime.HasValue ? "text-primary fw-bold" : "text-muted")">
                                                    @(req.RequestedClockOutTime?.ToLocalTime().ToString("HH:mm") ?? "No Change")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4 text-md-end">
                                @if (processingId == req.Id)
                                {
                                    <div class="d-flex justify-content-end align-items-center gap-2 text-primary fw-bold small">
                                        <span class="spinner-border spinner-border-sm"></span> Processing...
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-column gap-2">
                                        <input type="text" class="form-control form-control-sm border-0 bg-white shadow-inner rounded-pill px-3" placeholder="Add administrative comment..." @bind="adminComment" />
                                        <div class="d-flex gap-2 justify-content-md-end">
                                            <button class="btn btn-success btn-sm rounded-pill px-4 shadow-sm transition-all hover-translate-y" @onclick='() => ActionRequest(req.Id, "Approved")'>
                                                <i class="bi bi-check2 me-1"></i> Approve
                                            </button>
                                            <button class="btn btn-danger btn-sm rounded-pill px-4 shadow-sm transition-all hover-translate-y" @onclick='() => ActionRequest(req.Id, "Rejected")'>
                                                <i class="bi bi-x me-1"></i> Reject
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<AttendanceCorrection>? pendingRequests;
    private List<User>? users;
    private bool isLoading = true;
    private string? processingId;
    private string? adminComment;
    private string? SuccessMessage;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated || !AuthService.IsAdmin)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        users = await UserService.GetAllUsersAsync();
        await LoadRequests();
        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private User? GetEmployee(string id) => users?.FirstOrDefault(u => u.Id == id);

    private async Task LoadRequests()
    {
        isLoading = true;
        ErrorMessage = null;
        try
        {
            pendingRequests = await CorrectionService.GetPendingRequestsAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading requests: {ex.Message}";
            Console.WriteLine($"Error loading requests: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ActionRequest(string id, string status)
    {
        processingId = id;
        ErrorMessage = null;
        SuccessMessage = null;
        StateHasChanged();
        
        try
        {
            var adminId = AuthService.CurrentUser?.Id ?? "Admin";
            await CorrectionService.ReviewCorrectionAsync(id, status, adminComment, adminId);
            SuccessMessage = $"Request successfully {status.ToLower()}.";
            adminComment = null;
            await LoadRequests();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error actioning request: {ex.Message}";
            Console.WriteLine($"Error actioning request: {ex.Message}");
        }
        finally
        {
            processingId = null;
            await InvokeAsync(StateHasChanged);
        }
    }
}

<style>
    .x-small { font-size: 0.75rem; }
</style>
