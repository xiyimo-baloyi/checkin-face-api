@page "/admin/access-report"
@using Africanideasfaceapi.Services
@using Africanideasfaceapi.Models
@using Africanideasfaceapi.Helpers
@inject AnalyticsService AnalyticsService
@inject AttendanceService AttendanceService
@inject UserService UserService
@inject AuthService Auth
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Access & Identity Intelligence - Admin</PageTitle>

<div class="container-fluid mt-4 animate-fade-in pb-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-white shadow-sm rounded-circle p-2 transition-all hover-translate-y" @onclick='() => Navigation.NavigateTo("/admin/deep-analytics")'>
                <i class="bi bi-arrow-left text-primary"></i>
            </button>
            <div>
                <h2 class="fw-bold mb-1 text-primary">Access & Identity Intelligence</h2>
                <p class="text-muted mb-0 small">Visual audit of biometric attempts and security events</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <div class="glass-panel p-2 rounded-pill d-flex align-items-center shadow-sm">
                <span class="text-muted px-3 small fw-bold text-uppercase letter-spacing-wide">Min Confidence:</span>
                <select class="form-select border-0 bg-transparent fw-bold text-primary py-0" @bind="minConfidence" @bind:after="LoadData">
                    <option value="0.0">All Attempts</option>
                    <option value="0.4">40% (Related)</option>
                    <option value="0.6">60% (Medium)</option>
                    <option value="0.8">80% (High)</option>
                    <option value="0.9">90% (Strict)</option>
                </select>
            </div>
            <button class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="LoadData" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise me-2"></i>
                }
                Refresh
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-grow text-primary mb-3" role="status"></div>
            <p class="text-muted">Loading biometric audit trails...</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Summary Stats -->
            <div class="col-12">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="glass-panel p-3 rounded-4 border-0 shadow-sm">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1">Total Logs</small>
                            <h3 class="fw-bold text-primary mb-0">@loginLogs?.Count</h3>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-panel p-3 rounded-4 border-0 shadow-sm">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1">Failures</small>
                            <h3 class="fw-bold text-danger mb-0">@loginLogs?.Count(l => l.Result != "Success")</h3>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-panel p-3 rounded-4 border-0 shadow-sm">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1">Identity Matches</small>
                            <h3 class="fw-bold text-success mb-0">@faceLogs?.Count</h3>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="glass-panel p-3 rounded-4 border-0 shadow-sm">
                            <small class="text-muted text-uppercase fw-bold d-block mb-1">Visual Evidence</small>
                            <h3 class="fw-bold text-info mb-0">@faceLogs?.Count(l => !string.IsNullOrEmpty(l.FaceImagePath))</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabs -->
            <div class="col-12">
                <ul class="nav nav-pills mb-3 gap-2" id="reportTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill px-4 fw-bold @(activeTab == "gallery" ? "active" : "")" @onclick='() => SetTab("gallery")'>
                            <i class="bi bi-grid-3x3-gap me-2"></i> Visual Audit Gallery
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill px-4 fw-bold @(activeTab == "feed" ? "active" : "")" @onclick='() => SetTab("feed")'>
                            <i class="bi bi-list-ul me-2"></i> Full Access Feed
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill px-4 fw-bold @(activeTab == "similarity" ? "active" : "")" @onclick='() => SetTab("similarity")'>
                            <i class="bi bi-bar-chart-steps me-2"></i> Similarity
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill px-4 fw-bold @(activeTab == "attendance" ? "active" : "")" @onclick='() => SetTab("attendance")'>
                            <i class="bi bi-calendar-check me-2"></i> Attendance Log
                        </button>
                    </li>
                </ul>

                <div class="tab-content mt-4">
                    @if (activeTab == "gallery")
                    {
                        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4 animate-fade-in">
                            @if (faceLogs != null && faceLogs.Any())
                            {
                                @foreach (var log in faceLogs)
                                {
                                    <div class="col">
                                        <div class="card h-100 rounded-4 border-0 shadow-sm overflow-hidden transition-all hover-scale position-relative">
                                            <div class="position-relative" style="height: 200px;">
                                                @if (!string.IsNullOrEmpty(log.FaceImagePath))
                                                {
                                                    var gallerySrc = PathHelper.FixImagePath(log.FaceImagePath);
                                                    @if (!brokenImageSrcs.Contains(gallerySrc))
                                                    {
                                                        <img src="@gallerySrc" class="card-img-top w-100 h-100" style="object-fit: cover;" alt="Audit Image" @onerror="@(() => OnAuditImageError(gallerySrc))" />
                                                    }
                                                    else
                                                    {
                                                        <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                                            <i class="bi bi-image text-muted opacity-25" style="font-size: 3rem;" title="Image missing or moved"></i>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                                        <i class="bi bi-person-x text-muted opacity-25" style="font-size: 3rem;"></i>
                                                    </div>
                                                }
                                                <div class="position-absolute top-0 end-0 m-2">
                                                    <span class="badge @(log.Success ? "bg-success" : "bg-danger") shadow-sm rounded-pill px-3">
                                                        @(log.Success ? "Verified" : "Rejected")
                                                    </span>
                                                </div>
                                                <div class="position-absolute bottom-0 start-0 w-100 p-2 bg-dark bg-opacity-50 text-white backdrop-blur">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <small class="fw-bold">@log.ConfidenceScore.ToString("P0") Confidence</small>
                                                        <small class="opacity-75">@log.Timestamp.ToString("HH:mm")</small>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-body p-3">
                                                <div class="mb-2">
                                                    <small class="text-muted text-uppercase fw-bold x-small d-block mb-1">Intended User</small>
                                                    <div class="fw-bold text-dark text-truncate small">@ResolveEmployeeName(log.EmployeeId)</div>
                                                </div>
                                                
                                                @if (!log.Success && !string.IsNullOrEmpty(log.RecognizedUserEmail))
                                                {
                                                    <div class="alert alert-warning p-2 mb-0 border-0 rounded-3 mt-1" style="font-size: 0.7rem;">
                                                        <i class="bi bi-person-bounding-box me-1"></i> Similarity: <strong>@log.RecognizedUserEmail</strong>
                                                    </div>
                                                }
                                                else if (!log.Success)
                                                {
                                                     <div class="alert alert-danger p-2 mb-0 border-0 rounded-3 mt-1" style="font-size: 0.7rem;">
                                                        <i class="bi bi-exclamation-circle-fill me-1"></i> @(log.FailureCategory ?? "Unauthorized")
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-success x-small fw-bold mt-1">
                                                        <i class="bi bi-check-circle-fill me-1"></i> Identity Confirmed
                                                    </div>
                                                }
                                                
                                                <div class="mt-2 pt-2 border-top">
                                                    <small class="text-muted x-small">@log.Timestamp.ToString("dd MMM yyyy")</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="col-12 text-center py-5 opacity-50">
                                    <i class="bi bi-camera-off fs-1 d-block mb-3"></i>
                                    <p>No biometric images found matching the criteria.</p>
                                </div>
                            }
                        </div>
                    }
                    else if (activeTab == "similarity")
                    {
                        <div class="animate-fade-in">
                            @if (similarityByConfidence != null && similarityByConfidence.Any(g => g.Count > 0))
                            {
                                <div class="row g-4">
                                    @foreach (var group in similarityByConfidence.Where(g => g.Count > 0))
                                    {
                                        var badgeClass = group.Band == "High" ? "bg-success" : group.Band == "Medium" ? "bg-warning text-dark" : "bg-danger";
                                        var subtitle = group.Band == "High" ? "Verified-level matches" : group.Band == "Medium" ? "Moderate similarity" : "Potential confusion";
                                        <div class="col-12">
                                            <div class="glass-panel rounded-4 shadow-sm border-0 overflow-hidden @(group.Band == "High" ? "border border-success" : group.Band == "Medium" ? "border border-warning" : "border border-danger")">
                                                <div class="p-3 bg-light bg-opacity-50 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                    <div>
                                                        <h6 class="fw-bold mb-0 text-dark">@group.Band (@group.Label)</h6>
                                                        <small class="text-muted">@subtitle</small>
                                                    </div>
                                                    <span class="badge @badgeClass rounded-pill px-3 py-2">@group.Count attempts</span>
                                                </div>
                                                <div class="p-4">
                                                    @if (group.Insights.Any())
                                                    {
                                                        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
                                                            @foreach (var insight in group.Insights)
                                                            {
                                                                <div class="col">
                                                                    <div class="card h-100 rounded-4 border-0 shadow-sm overflow-hidden transition-all hover-scale">
                                                                        <div class="position-relative" style="height: 200px;">
                                                                            @if (!string.IsNullOrEmpty(insight.ImagePath))
                                                                            {
                                                                                var similaritySrc = PathHelper.FixImagePath(insight.ImagePath);
                                                                                @if (!brokenImageSrcs.Contains(similaritySrc))
                                                                                {
                                                                                    <img src="@similaritySrc" class="card-img-top w-100 h-100" style="object-fit: cover;" alt="Audit Image" @onerror="@(() => OnAuditImageError(similaritySrc))" />
                                                                                }
                                                                                else
                                                                                {
                                                                                    <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                                                                        <i class="bi bi-image text-muted opacity-25" style="font-size: 3rem;" title="Image missing or moved"></i>
                                                                                    </div>
                                                                                }
                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center">
                                                                                    <i class="bi bi-person-x text-muted opacity-25" style="font-size: 3rem;"></i>
                                                                                </div>
                                                                            }
                                                                            <div class="position-absolute top-0 end-0 m-2">
                                                                                <span class="badge @(insight.IsSuccess ? "bg-success" : "bg-danger") shadow-sm rounded-pill px-3">
                                                                                    @(insight.IsSuccess ? "Verified" : "Rejected")
                                                                                </span>
                                                                            </div>
                                                                            <div class="position-absolute bottom-0 start-0 w-100 p-2 bg-dark bg-opacity-50 text-white backdrop-blur">
                                                                                <div class="d-flex justify-content-between align-items-center">
                                                                                    <small class="fw-bold">@insight.Confidence.ToString("P0")</small>
                                                                                    <small class="opacity-75">@insight.Timestamp.ToString("HH:mm")</small>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                        <div class="card-body p-3">
                                                                            <div class="mb-2">
                                                                                <small class="text-muted text-uppercase fw-bold x-small d-block mb-1">Attempted For</small>
                                                                                <div class="fw-bold text-dark text-truncate small">@insight.AttemptedUserName</div>
                                                                            </div>
                                                                            @if (!insight.IsSuccess && !string.IsNullOrEmpty(insight.RecognizedUserEmail))
                                                                            {
                                                                                <div class="alert alert-warning p-2 mb-0 border-0 rounded-3 mt-1" style="font-size: 0.7rem;">
                                                                                    <i class="bi bi-person-bounding-box me-1"></i> Similarity: <strong>@insight.RecognizedUserEmail</strong>
                                                                                </div>
                                                                            }
                                                                            else if (!insight.IsSuccess)
                                                                            {
                                                                                <div class="alert alert-danger p-2 mb-0 border-0 rounded-3 mt-1" style="font-size: 0.7rem;">
                                                                                    <i class="bi bi-exclamation-circle-fill me-1"></i> @(insight.FailureCategory ?? "Unauthorized")
                                                                                </div>
                                                                            }
                                                                            <div class="mt-2 pt-2 border-top">
                                                                                <small class="text-muted x-small">@insight.Timestamp.ToString("dd MMM yyyy")</small>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                        @if (group.Count > group.Insights.Count)
                                                        {
                                                            <small class="text-muted d-block mt-3">Showing @group.Insights.Count of @group.Count attempts</small>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <p class="text-muted small mb-0">No attempts in this band</p>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center py-5 opacity-50">
                                    <i class="bi bi-bar-chart-steps fs-1 d-block mb-3"></i>
                                    <p>No similarity data grouped by confidence band.</p>
                                </div>
                            }
                        </div>
                    }
                    else if (activeTab == "attendance")
                    {
                        <div class="glass-panel rounded-4 shadow-sm border-0 overflow-hidden animate-fade-in">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light bg-opacity-50">
                                        <tr>
                                            <th class="border-0 px-4 py-3 small text-muted text-uppercase fw-bold">Employee</th>
                                            <th class="border-0 px-4 py-3 small text-muted text-uppercase fw-bold">Action</th>
                                            <th class="border-0 px-4 py-3 small text-muted text-uppercase fw-bold">Location</th>
                                            <th class="border-0 px-4 py-3 small text-muted text-uppercase fw-bold">Status</th>
                                            <th class="border-0 px-4 py-3 small text-muted text-uppercase fw-bold">GPS Coordinates</th>
                                            <th class="border-0 px-4 py-3 small text-muted text-uppercase fw-bold">Time</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (attendanceLogs != null && attendanceLogs.Any())
                                        {
                                            @foreach (var log in attendanceLogs)
                                            {
                                                <tr>
                                                    <td class="px-4 py-3">
                                                        <div class="d-flex align-items-center gap-3">
                                                            <div class="rounded-circle bg-info bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                                                                <i class="bi bi-person-badge text-info"></i>
                                                            </div>
                                                            <div>
                                                                <div class="fw-bold text-dark">@ResolveEmployeeName(log.EmployeeId)</div>
                                                                <small class="text-muted x-small">@log.EmployeeId</small>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        @if (log.ClockInTime.HasValue && log.ClockOutTime == null)
                                                        {
                                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3"><i class="bi bi-box-arrow-in-right me-1"></i> Clock In</span>
                                                        }
                                                        else if (log.ClockOutTime.HasValue)
                                                        {
                                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3"><i class="bi bi-box-arrow-left me-1"></i> Clock Out</span>
                                                        }
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        @if (log.IsOutOfArea)
                                                        {
                                                            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3">Out of Area</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-light text-muted rounded-pill px-3">In Area</span>
                                                        }
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        <span class="text-muted small">@(log.Status ?? "Present")</span>
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        @if (log.Latitude.HasValue && log.Longitude.HasValue)
                                                        {
                                                            <a href="https://www.google.com/maps?q=@(log.Latitude),@(log.Longitude)" target="_blank" class="text-decoration-none small d-flex align-items-center">
                                                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                                                @log.Latitude.Value.ToString("F4"), @log.Longitude.Value.ToString("F4")
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted x-small">No GPS captured</span>
                                                        }
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        <div class="fw-bold text-dark small">@(log.ClockOutTime?.ToString("HH:mm:ss") ?? log.ClockInTime?.ToString("HH:mm:ss") ?? "N/A")</div>
                                                        <small class="text-muted x-small">@log.Date.ToString("dd MMM yyyy")</small>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center py-5 text-muted">
                                                    No attendance logs found for the selected period.
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="glass-panel rounded-4 shadow-sm border-0 overflow-hidden animate-fade-in">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="bg-light bg-opacity-50">
                                        <tr>
                                            <th class="border-0 px-4 py-3 small text-muted text-uppercase fw-bold">Identity</th>
                                            <th class="border-0 px-4 py-3 small text-muted text-uppercase fw-bold">Status</th>
                                            <th class="border-0 px-4 py-3 small text-muted text-uppercase fw-bold">Location</th>
                                            <th class="border-0 px-4 py-3 small text-muted text-uppercase fw-bold">Reason / Method</th>
                                            <th class="border-0 px-4 py-3 small text-muted text-uppercase fw-bold">Time</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (loginLogs != null && loginLogs.Any())
                                        {
                                            @foreach (var log in loginLogs)
                                            {
                                                <tr>
                                                    <td class="px-4 py-3">
                                                        <div class="d-flex align-items-center gap-3">
                                                            <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 35px; height: 35px;">
                                                                <i class="bi bi-person text-primary"></i>
                                                            </div>
                                                            <div>
                                                                <div class="fw-bold text-dark">@log.Email</div>
                                                                <small class="text-muted x-small">ID: @log.UserId</small>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        @if (log.Result == "Success")
                                                        {
                                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Success</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3">Failed</span>
                                                        }
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        @if (log.Latitude.HasValue && log.Longitude.HasValue)
                                                        {
                                                            <a href="https://www.google.com/maps?q=@(log.Latitude),@(log.Longitude)" target="_blank" class="text-decoration-none small d-flex align-items-center">
                                                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                                                @log.Latitude.Value.ToString("F4"), @log.Longitude.Value.ToString("F4")
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted x-small">No GPS Data</span>
                                                        }
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        <span class="text-muted small">@(log.ErrorMessage ?? "Standard Login")</span>
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        <div class="fw-bold text-dark small">@log.Timestamp.ToString("HH:mm:ss")</div>
                                                        <small class="text-muted x-small">@log.Timestamp.ToString("dd MMM yyyy")</small>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center py-5 text-muted">
                                                    No access logs found for the selected period.
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    .hover-scale:hover {
        transform: translateY(-5px) scale(1.02);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        z-index: 10;
    }
    .backdrop-blur {
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }
    .x-small {
        font-size: 0.75rem;
    }
</style>

@code {
    private readonly HashSet<string> brokenImageSrcs = new(StringComparer.OrdinalIgnoreCase);

    private List<AuditLog>? loginLogs;
    private List<FaceLog>? faceLogs;
    private List<Attendance>? attendanceLogs;
    private List<SimilarityGroupByConfidence>? similarityByConfidence;
    private Dictionary<string, string> employeeNames = new();
    private bool isLoading = true;
    private double minConfidence = 0.4;
    private string activeTab = "gallery";

    private string ResolveEmployeeName(string? employeeId)
    {
        if (string.IsNullOrEmpty(employeeId)) return "Unknown";
        return employeeNames.TryGetValue(employeeId, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : employeeId;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!Auth.IsAuthenticated || !Auth.IsAdmin)
            {
                Navigation.NavigateTo("/login");
                return;
            }
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            loginLogs = await AnalyticsService.GetDetailedLoginLogsAsync(100);
            faceLogs = await AnalyticsService.GetHighConfidenceAttemptsAsync(minConfidence, 60);
            similarityByConfidence = await AnalyticsService.GetSimilarityInsightsGroupedByConfidenceAsync(null, null, 15);
            attendanceLogs = await AttendanceService.GetRecentAttendanceAsync(50);

            try
            {
                var users = await UserService.GetAllUsersAsync();
                employeeNames = users
                    .Where(u => !string.IsNullOrEmpty(u.Id))
                    .ToDictionary(u => u.Id, u => string.IsNullOrEmpty(u.Surname) ? u.Name : $"{u.Name} {u.Surname}");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to load employee names: {ex.Message}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading access report: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        StateHasChanged();
    }

    private Task OnAuditImageError(string resolvedSrc)
    {
        if (string.IsNullOrEmpty(resolvedSrc)) return Task.CompletedTask;
        if (brokenImageSrcs.Add(resolvedSrc))
            StateHasChanged();
        return Task.CompletedTask;
    }
}
