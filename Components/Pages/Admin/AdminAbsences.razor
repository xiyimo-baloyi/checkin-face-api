@page "/admin/absences"
@using Africanideasfaceapi.Models
@using Africanideasfaceapi.Services
@using Africanideasfaceapi.Helpers
@inject AbsenceService AbsenceService
@inject AuthService Auth
@inject NavigationManager Navigation
@inject UserService UserService
@inject IJSRuntime JSRuntime

<PageTitle>Admin: Absence Management - Attendance System</PageTitle>

<div class="container-fluid mt-4 animate-fade-in pb-5">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
        <div class="d-flex align-items-center gap-3 w-100 w-md-auto">
            <div class="bg-white rounded-circle p-1 d-flex align-items-center justify-content-center shadow-sm d-none d-md-flex" style="width: 50px; height: 50px;">
                <img src="/images/african-ideas-logo.png" alt="Logo" class="w-100" />
            </div>
            <div>
                <h2 class="fw-bold mb-1 text-primary mobile-h2">Absence Management</h2>
                <p class="text-muted mb-0 small mobile-d-none">Review submitted reasons and detect missing worker clock-ins.</p>
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center w-100 w-md-auto justify-content-between justify-content-md-end">
            <button class="btn btn-warning btn-sm rounded-pill px-3 shadow-sm fw-bold transition-all hover-translate-y flex-grow-1 flex-md-grow-0 @(isDetecting ? "opacity-75" : "")" @onclick="RunDetection" disabled="@isDetecting">
                @if (isDetecting)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    <span class="d-none d-sm-inline">Analyzing...</span>
                }
                else
                {
                    <i class="bi bi-search-heart me-1"></i>
                    <span>Run Detection</span>
                }
            </button>
            <button class="btn btn-white btn-sm rounded-pill px-3 shadow-sm border transition-all hover-translate-y flex-grow-1 flex-md-grow-0" @onclick="GoToDashboard">
                 <i class="bi bi-grid-fill me-1"></i><span class="d-none d-sm-inline">Dashboard</span><span class="d-inline d-sm-none">Back</span>
            </button>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="glass-panel p-3 border-0 shadow-sm rounded-4 bg-primary bg-opacity-10 text-primary h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-uppercase fw-bold opacity-75">Pending Action</small>
                        <h3 class="fw-bold mb-0">@(pendingAbsences?.Count ?? 0)</h3>
                    </div>
                    <i class="bi bi-clock-history fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-panel p-3 border-0 shadow-sm rounded-4 bg-success bg-opacity-10 text-success h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-uppercase fw-bold opacity-75">Today's Detected</small>
                        <h3 class="fw-bold mb-0">@todayAbsenceCount</h3>
                    </div>
                    <i class="bi bi-exclamation-triangle fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-panel p-3 border-0 shadow-sm rounded-4 bg-info bg-opacity-10 text-info h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <small class="text-uppercase fw-bold opacity-75">Total Resolved</small>
                        <h3 class="fw-bold mb-0">@resolvedAbsenceCount</h3>
                    </div>
                    <i class="bi bi-check-circle fs-1 opacity-25"></i>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success border-0 bg-success bg-opacity-10 rounded-pill px-4 mb-4 animate-fade-in d-flex align-items-center">
            <i class="bi bi-check-circle-fill me-3 fs-5"></i>
            <span class="fw-bold">@successMessage</span>
            <button type="button" class="btn-close ms-auto" @onclick="() => successMessage = null"></button>
        </div>
    }

    <!-- Tabs and Table -->
    <div class="glass-panel p-0 rounded-4 shadow-sm border-0 overflow-hidden bg-white">
        <div class="p-4 border-bottom border-light d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div class="btn-group rounded-pill p-1 bg-light shadow-sm" style="width: fit-content;">
                <button class="btn btn-sm rounded-pill px-4 fw-bold @(currentTab == "pending" ? "btn-primary shadow-sm" : "btn-light text-muted")" @onclick='() => SetTab("pending")'>
                    Pending Review
                </button>
                <button class="btn btn-sm rounded-pill px-4 fw-bold @(currentTab == "history" ? "btn-primary shadow-sm" : "btn-light text-muted")" @onclick='() => SetTab("history")'>
                    All History
                </button>
            </div>
            
            <button class="btn btn-white btn-sm shadow-sm border rounded-circle transition-all hover-translate-y ms-auto" @onclick="RefreshData" title="Refresh List">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
        
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-grow text-primary" role="status"></div>
                <p class="mt-3 text-muted fw-bold">Gathering reports...</p>
            </div>
        }
        else if (displayAbsences == null || !displayAbsences.Any())
        {
            <div class="text-center py-5">
                <div class="rounded-circle bg-light d-inline-flex p-4 mb-3">
                    <i class="bi bi-check-all text-success fs-1"></i>
                </div>
                <h5 class="fw-bold">All caught up!</h5>
                <p class="text-muted">No @currentTab records found matching your selection.</p>
            </div>
        }
        else
        {
            <!-- Desktop Table View -->
            <div class="desktop-only-table table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light bg-opacity-50 text-uppercase small letter-spacing-wide">
                        <tr>
                            <th class="ps-4">Employee Details</th>
                            <th>Date</th>
                            <th>Status / Type</th>
                            <th>Submitted Reason</th>
                            <th class="text-end pe-4">Decisions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in displayAbsences)
                        {
                            var employee = GetEmployee(record.EmployeeId);
                            <tr @key="record.Id">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle border border-2 border-white shadow-sm overflow-hidden" style="width: 40px; height: 40px;">
                                            @if (!string.IsNullOrEmpty(employee?.ImageBase64))
                                            {
                                                <img src="data:image/jpeg;base64,@employee.ImageBase64" alt="Photo" class="w-100 h-100" style="object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="w-100 h-100 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold">
                                                    @(employee?.Name?.FirstOrDefault() ?? 'U')
                                                </div>
                                            }
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@(employee != null ? $"{employee.Name} {employee.Surname}" : "Unknown Employee")</div>
                                            <div class="text-muted small">ID: @record.EmployeeId</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold">@record.Date.ToString("ddd, dd MMM yyyy")</span>
                                </td>
                                <td>
                                    <div class="d-flex flex-column gap-1">
                                        <span class="badge @GetStatusClass(record.Status) rounded-pill px-3" style="width: fit-content; font-size: 0.65rem;">
                                            @record.Status
                                        </span>
                                        <span class="badge @GetTypeClass(record.AbsenceType) bg-opacity-10 rounded-pill px-3" style="width: fit-content; font-size: 0.65rem;">
                                            @(record.AbsenceType ?? "Unexplained")
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="p-2 px-3 bg-light rounded-3 small border border-light" style="max-width: 350px;">
                                        @if (string.IsNullOrEmpty(record.Reason))
                                        {
                                            <span class="text-muted fst-italic"><i class="bi bi-clock me-1"></i> Awaiting input...</span>
                                        }
                                        else
                                        {
                                            <span class="text-dark">@record.Reason</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    @if (record.Status == "Pending" && !string.IsNullOrEmpty(record.Reason))
                                    {
                                        <div class="d-flex gap-2 justify-content-end">
                                            <button class="btn btn-success btn-sm rounded-pill px-3 shadow-sm transition-all hover-translate-y" @onclick="() => Approve(record.Id)">
                                                <i class="bi bi-check2"></i>
                                            </button>
                                            <button class="btn btn-danger btn-sm rounded-pill px-3 shadow-sm transition-all hover-translate-y" @onclick="() => Reject(record.Id)">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                    }
                                    else if (record.Status == "Pending")
                                    {
                                         <span class="text-muted small">Awaiting Submission</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fw-bold">Finalized</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View -->
            <div class="mobile-only-cards p-2 p-md-3">
                @foreach (var record in displayAbsences)
                {
                    var employee = GetEmployee(record.EmployeeId);
                    <div class="worker-card-mobile animate-fade-in" @key="@($"abs-{record.Id}")">
                        <div class="worker-header">
                            <div class="worker-avatar-container">
                                @if (!string.IsNullOrEmpty(employee?.ImageBase64))
                                {
                                    <img src="data:image/jpeg;base64,@employee.ImageBase64" alt="Photo" class="worker-avatar" />
                                }
                                else
                                {
                                    <div class="worker-avatar d-flex align-items-center justify-content-center bg-primary bg-opacity-10">
                                        <i class="bi bi-person-fill text-primary"></i>
                                    </div>
                                }
                            </div>
                            <div class="worker-info">
                                <div class="worker-name">@(employee != null ? $"{employee.Name} {employee.Surname}" : "Unknown")</div>
                                <div class="worker-id">@record.Date.ToString("ddd, dd MMM yyyy")</div>
                                <div class="mt-1 d-flex gap-1">
                                    <span class="badge @GetStatusClass(record.Status) rounded-pill px-2 py-1" style="font-size: 0.6rem;">
                                        @record.Status
                                    </span>
                                    <span class="badge @GetTypeClass(record.AbsenceType) bg-opacity-10 rounded-pill px-2 py-1" style="font-size: 0.6rem;">
                                        @(record.AbsenceType ?? "Unexplained")
                                    </span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="worker-details">
                            <div class="detail-item w-100">
                                <span class="detail-label d-block mb-1">Submitted Reason</span>
                                <div class="p-2 bg-light rounded-3 small border border-light">
                                    @if (string.IsNullOrEmpty(record.Reason))
                                    {
                                        <span class="text-muted fst-italic">No reason submitted yet.</span>
                                    }
                                    else
                                    {
                                        <span class="text-dark">@record.Reason</span>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (record.Status == "Pending" && !string.IsNullOrEmpty(record.Reason))
                        {
                            <div class="worker-actions-grid mt-3">
                                <button class="btn btn-outline-success rounded-pill btn-sm py-2 fw-bold" @onclick="() => Approve(record.Id)">
                                    <i class="bi bi-check2 me-1"></i> Approve
                                </button>
                                <button class="btn btn-outline-danger rounded-pill btn-sm py-2 fw-bold" @onclick="() => Reject(record.Id)">
                                    <i class="bi bi-x-lg me-1"></i> Reject
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<Absence>? pendingAbsences;
    private List<Absence>? allAbsences;
    private List<Absence>? displayAbsences;
    private List<User>? users;
    private bool isLoading = true;
    private bool isDetecting = false;
    private string? successMessage;
    private string currentTab = "pending";

    // Summary Metrics
    private int todayAbsenceCount = 0;
    private int resolvedAbsenceCount = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!Auth.IsAuthenticated || !Auth.IsAdmin)
            {
                Navigation.NavigateTo("/login");
                return;
            }
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        users = await UserService.GetAllUsersAsync();
        allAbsences = await AbsenceService.GetAllAbsencesAsync();
        
        CalculateMetrics();
        UpdateDisplayList();
        
        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void CalculateMetrics()
    {
        if (allAbsences == null) return;
        
        pendingAbsences = allAbsences.Where(a => a.Status == "Pending").ToList();
        resolvedAbsenceCount = allAbsences.Count(a => a.Status != "Pending");
        todayAbsenceCount = allAbsences.Count(a => a.Date.Date == DateTime.Today);
    }

    private void UpdateDisplayList()
    {
        if (currentTab == "pending")
        {
            displayAbsences = pendingAbsences;
        }
        else
        {
            displayAbsences = allAbsences;
        }
    }

    private async Task RefreshData() => await LoadData();

    private void SetTab(string tab)
    {
        currentTab = tab;
        UpdateDisplayList();
    }

    private User? GetEmployee(string id) => users?.FirstOrDefault(u => u.Id == id);

    private async Task RunDetection()
    {
        isDetecting = true;
        try
        {
            var yesterday = TimeHelper.GetToday().AddDays(-1);
            var created = await AbsenceService.RunAbsenceDetectionAsync(yesterday);
            successMessage = $"Detection complete. Created {created} new absence records for {yesterday.ToShortDateString()}.";
            await LoadData();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error: " + ex.Message);
        }
        finally
        {
            isDetecting = false;
        }
    }

    private async Task Approve(string id)
    {
        var success = await AbsenceService.ApproveAbsenceAsync(id);
        if (success)
        {
            successMessage = "Record approved and balance deducted.";
            await LoadData();
        }
    }

    private async Task Reject(string id)
    {
        var success = await AbsenceService.RejectAbsenceAsync(id);
        if (success)
        {
            successMessage = "Record rejected.";
            await LoadData();
        }
    }

    private string GetStatusClass(string status) => status switch
    {
        "Approved" => "bg-success text-success bg-opacity-10",
        "Rejected" => "bg-danger text-danger bg-opacity-10",
        "Pending" => "bg-warning text-warning bg-opacity-10",
        _ => "bg-light text-muted"
    };

    private string GetTypeClass(string? type) => type switch
    {
        "Unexplained" => "bg-danger text-danger",
        "Sick" => "bg-info text-info",
        "Personal" => "bg-secondary text-secondary",
        _ => "bg-primary text-primary"
    };

    private void GoToDashboard() => Navigation.NavigateTo("/admin");
}
