@page "/admin/audit"
@using Africanideasfaceapi.Services
@using Africanideasfaceapi.Models
@using Africanideasfaceapi.Data
@using Microsoft.EntityFrameworkCore
@inject AnalyticsService AnalyticsService
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Security & Audit - Administration</PageTitle>

<div class="container-fluid mt-4 animate-fade-in pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-white rounded-circle p-1 d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px;">
                <img src="/images/african-ideas-logo.png" alt="Logo" class="w-100" />
            </div>
            <div>
                <h2 class="fw-bold mb-1 text-primary">Security & Audit Hub</h2>
                <p class="text-muted mb-0">Comprehensive system trails, biometric logs, and administrative actions.</p>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- System Logs -->
        <div class="col-lg-8">
            <div class="glass-panel p-0 rounded-4 shadow-sm border-0 overflow-hidden">
                <div class="p-4 border-bottom border-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-shield-lock me-2 text-primary"></i>Recent System Activity</h5>
                    <button class="btn btn-sm btn-outline-secondary rounded-pill" @onclick="LoadAuditLogs">Refresh</button>
                </div>
                <div class="table-responsive" style="max-height: 500px;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light small">
                            <tr>
                                <th class="ps-4">Timestamp</th>
                                <th>User</th>
                                <th>Action</th>
                                <th>Location</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (auditLogs == null)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading…</span></div>
                                        <p class="text-muted small mt-2 mb-0">Loading audit trail…</p>
                                    </td>
                                </tr>
                            }
                            else if (!auditLogs.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">No audit logs found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var log in auditLogs)
                                {
                                    <tr @key="log.Id">
                                        <td class="ps-4 small text-muted">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td>
                                            <div class="fw-bold small">@log.Email</div>
                                        </td>
                                        <td>
                                            <span class="badge @(log.Result == "Success" ? "bg-success" : "bg-danger") bg-opacity-10 @(log.Result == "Success" ? "text-success" : "text-danger") rounded-pill px-2">@log.ActionType</span>
                                        </td>
                                        <td class="small">
                                            @if (log.Latitude.HasValue && log.Longitude.HasValue)
                                            {
                                                <a href="https://www.google.com/maps?q=@(log.Latitude),@(log.Longitude)" target="_blank" rel="noopener" class="text-decoration-none">
                                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                                    @log.Latitude.Value.ToString("F4"), @log.Longitude.Value.ToString("F4")
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted opacity-50">No GPS</span>
                                            }
                                        </td>
                                        <td class="small">@log.ErrorMessage</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Biometric Attempts -->
        <div class="col-lg-4">
            <div class="glass-panel p-0 rounded-4 shadow-sm border-0 overflow-hidden h-100">
                <div class="p-4 border-bottom border-light">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-person-bounding-box me-2 text-primary"></i>Biometric Feed</h5>
                </div>
                <div class="p-3 overflow-auto" style="max-height: 500px;">
                    @if (faceLogs == null)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading…</span></div>
                            <p class="text-muted small mt-2 mb-0">Loading biometric feed…</p>
                        </div>
                    }
                    else if (!faceLogs.Any())
                    {
                        <div class="text-center py-5 opacity-50">
                            <i class="bi bi-camera-slash fs-1 d-block mb-3"></i>
                            <p class="small">No recent biometric attempts.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var log in faceLogs)
                        {
                            <div @key="log.Timestamp.Ticks" class="card border-0 bg-light bg-opacity-50 rounded-3 mb-3 p-3 transition-all hover-translate-y shadow-sm">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge @(log.IsSuccess ? "bg-success" : "bg-danger") rounded-pill px-2">@(log.IsSuccess ? "Verified" : "Rejected")</span>
                                    <small class="text-muted">@log.Timestamp.ToString("HH:mm")</small>
                                </div>
                                <div class="fw-bold small mb-1">Attempt: @log.AttemptedUserName</div>
                                <div class="progress rounded-pill bg-white mb-2" style="height: 4px;">
                                    <div class="progress-bar @(log.Confidence > 0.8 ? "bg-success" : "bg-warning")" style="width: @(log.Confidence * 100)%"></div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">Score: @log.Confidence.ToString("P1")</small>
                                    @if(!log.IsSuccess && !string.IsNullOrEmpty(log.RecognizedUserEmail)) {
                                        <small class="text-danger fw-bold">Similar: @log.RecognizedUserEmail</small>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<AuditLog>? auditLogs;
    private List<SimilarityInsight>? faceLogs;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!Auth.IsAuthenticated || !Auth.IsAdmin)
            {
                Navigation.NavigateTo("/login");
                return;
            }
            await LoadLogs();
        }
    }

    private async Task LoadLogs()
    {
        await LoadAuditLogs();
        await LoadFaceLogs();
    }

    private async Task LoadAuditLogs()
    {
        try
        {
            auditLogs = await AnalyticsService.GetRecentActivityAsync(100);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading audit logs: {ex.Message}");
            auditLogs = new List<AuditLog>();
        }
    }

    private async Task LoadFaceLogs()
    {
        try
        {
            faceLogs = await AnalyticsService.GetSimilarityInsightsAsync(20);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading face logs: {ex.Message}");
            faceLogs = new List<SimilarityInsight>();
        }
    }
}
