@page "/admin/leave"
@using Africanideasfaceapi.Services
@using Africanideasfaceapi.Models
@inject LeaveService LeaveService
@inject UserService UserService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Leave Approvals - Admin</PageTitle>

<div class="animate-fade-in pb-5">
    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between mb-4 mb-md-5 border-bottom pb-3 gap-3">
        <div>
            <h2 class="fw-bold mb-1 text-dark" style="color: #0f172a !important; font-size: clamp(1.5rem, 4vw, 2rem);">Leave Management</h2>
            <p class="text-muted mb-0 opacity-75" style="font-size: clamp(0.85rem, 2vw, 1rem);">Review and action employee leave requests across the organization.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn @(activeTab == "pending" ? "btn-primary" : "btn-outline-primary") rounded-pill px-4 fw-bold shadow-sm" @onclick='() => SetTab("pending")'>
                <i class="bi bi-clock-history me-2"></i> Pending
            </button>
            <button class="btn @(activeTab == "history" ? "btn-primary" : "btn-outline-primary") rounded-pill px-4 fw-bold shadow-sm" @onclick='() => SetTab("history")'>
                <i class="bi bi-journals me-2"></i> All History
            </button>
            <button class="btn @(activeTab == "calendar" ? "btn-primary" : "btn-outline-primary") rounded-pill px-4 fw-bold shadow-sm" @onclick='() => SetTab("calendar")'>
                <i class="bi bi-calendar3 me-2"></i> Calendar View
            </button>
        </div>
    </div>

    @if (requests == null)
    {
        <div class="d-flex justify-content-center align-items-center" style="min-height: 40vh;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (activeTab == "calendar")
    {
        <div class="glass-panel p-4 rounded-4 shadow-sm bg-white mb-5 animate-fade-in">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0 text-dark">Team Leave Calendar</h5>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-light btn-sm rounded-pill" @onclick="PrevMonth"><i class="bi bi-chevron-left"></i></button>
                    <span class="fw-bold px-3">@currentCalendarDate.ToString("MMMM yyyy")</span>
                    <button class="btn btn-light btn-sm rounded-pill" @onclick="NextMonth"><i class="bi bi-chevron-right"></i></button>
                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 ms-2" @onclick="GoToToday">Today</button>
                </div>
            </div>

            <div class="calendar-grid">
                <div class="calendar-header-row">
                    <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
                </div>
                <div class="calendar-body">
                    @foreach (var day in calendarDays)
                    {
                        var dayRequests = GetRequestsForDay(day);
                        <div @key="day.Ticks" class="calendar-day @(day.Month != currentCalendarDate.Month ? "text-muted opacity-50" : "") @(day.Date == DateTime.Today ? "today-highlight" : "")">
                            <span class="day-number">@day.Day</span>
                            <div class="day-events">
                                @foreach (var req in dayRequests.Take(3))
                                {
                                    <div class="event-line @(req.Status == "Approved" ? "bg-success" : "bg-warning") text-white" 
                                         title="@req.EmployeeName: @req.LeaveType (@req.Status)">
                                        <small>@req.EmployeeName</small>
                                    </div>
                                }
                                @if (dayRequests.Count > 3)
                                {
                                    <div class="text-muted small px-1">+@(dayRequests.Count - 3) more</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-4 pt-3 border-top d-flex gap-4">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-success" style="width: 12px; height: 12px;"></div>
                    <small class="text-muted">Approved Leave</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-warning" style="width: 12px; height: 12px;"></div>
                    <small class="text-muted">Pending Approval</small>
                </div>
            </div>
        </div>

        <style>
            .calendar-grid { border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; }
            .calendar-header-row { display: grid; grid-template-columns: repeat(7, 1fr); background: #f8fafc; text-align: center; border-bottom: 1px solid #e2e8f0; }
            .calendar-header-row span { padding: 12px; font-size: 0.75rem; font-weight: 800; color: #64748b; text-transform: uppercase; }
            .calendar-body { display: grid; grid-template-columns: repeat(7, 1fr); }
            .calendar-day { min-height: 120px; border-right: 1px solid #f1f5f9; border-bottom: 1px solid #f1f5f9; padding: 8px; position: relative; }
            .calendar-day:nth-child(7n) { border-right: none; }
            .day-number { font-size: 0.85rem; font-weight: 600; color: #1e293b; }
            .today-highlight { background: rgba(37, 99, 235, 0.03); }
            .today-highlight .day-number { background: #2563eb; color: white; border-radius: 50%; width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center; }
            .day-events { display: flex; flex-direction: column; gap: 2px; margin-top: 8px; }
            .event-line { border-radius: 4px; padding: 2px 6px; font-size: 0.65rem; font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: help; }
        </style>
    }
    else
    {
        <div class="glass-panel p-0 rounded-4 shadow-sm overflow-hidden mb-5 bg-white">
            <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-dark">@(activeTab == "pending" ? "Awaiting Action" : "Request Archives")</h5>
                <span class="badge rounded-pill bg-light text-dark border px-3 py-2 fw-bold" style="font-size: 0.75rem;">
                    @requests.Count records found
                </span>
            </div>
            
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="text-uppercase small" style="color: #94a3b8; font-size: 0.65rem; letter-spacing: 0.05rem;">
                        <tr>
                            <th class="ps-4 py-4">Employee</th>
                            <th class="py-4">Type</th>
                            <th class="py-4">Duration</th>
                            <th class="py-4">Status & Reason</th>
                            <th class="text-end pe-4 py-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @if (!requests.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="py-4 text-muted opacity-50">
                                        <i class="bi bi-inbox fs-1 d-block mb-3 opacity-25"></i>
                                        No @activeTab leave requests found.
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var req in requests)
                            {
                                <tr @key="req.Id" class="border-top hover-bg-light transition-all">
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary bg-gradient text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; font-size: 0.9rem;">
                                                 <span class="fw-bold">@((req.EmployeeName ?? "U").Substring(0, 1).ToUpper())</span>
                                            </div>
                                            <div class="ms-3">
                                                <div class="fw-bold text-dark h6 mb-0">@(req.EmployeeName ?? employeeNames.GetValueOrDefault(req.EmployeeId, "User"))</div>
                                                <div class="text-muted small">@req.EmployeeId.Substring(Math.Max(0, req.EmployeeId.Length - 8))</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle" style="width: 8px; height: 8px; background: @GetTypeColor(req.LeaveType);"></div>
                                            <span class="fw-bold text-dark">@req.LeaveType</span>
                                        </div>
                                        <small class="text-muted opacity-75">@req.CreatedAt.ToString("MMM dd, yyyy")</small>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@req.StartDate.ToString("MMM dd") - @req.EndDate.ToString("MMM dd")</div>
                                        <div class="text-muted small">@req.DurationDays days requested</div>
                                    </td>
                                    <td>
                                        <div class="mb-1">
                                            @switch (req.Status)
                                            {
                                                case "Approved": <span class="badge rounded-pill" style="background: #dcfce7; color: #166534; font-size: 0.7rem;"><i class="bi bi-check-circle-fill me-1"></i> Approved</span> break;
                                                case "Rejected": <span class="badge rounded-pill" style="background: #fee2e2; color: #991b1b; font-size: 0.7rem;"><i class="bi bi-x-circle-fill me-1"></i> Rejected</span> break;
                                                default: <span class="badge rounded-pill" style="background: #fef3c7; color: #92400e; font-size: 0.7rem;"><i class="bi bi-clock-fill me-1"></i> Pending</span> break;
                                            }
                                        </div>
                                        <div class="text-wrap text-muted small" style="max-width: 250px; font-style: italic;">
                                            "@req.Reason"
                                        </div>
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (req.Status == "Pending")
                                        {
                                            <div class="d-flex justify-content-end gap-2">
                                                <button class="btn btn-success btn-sm rounded-pill px-3 fw-bold transition-all hover-translate-y" @onclick="() => OpenReviewModal(req, true)">
                                                    <i class="bi bi-check-lg me-1"></i> Approve
                                                </button>
                                                <button class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold transition-all hover-translate-y" @onclick="() => OpenReviewModal(req, false)">
                                                    <i class="bi bi-x-lg me-1"></i> Reject
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-muted small">
                                                By @(req.ReviewedBy ?? "System")<br/>
                                                on @req.ReviewedAt?.ToString("MMM dd")
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (showModal && selectedRequest != null)
{
    <div class="modal show d-block animate-fade-in" tabindex="-1" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header @(isApproving ? "bg-success" : "bg-danger") text-white border-0 py-3">
                    <h5 class="modal-title fw-bold">
                        <i class="bi @(isApproving ? "bi-check-circle-fill" : "bi-x-circle-fill") me-2"></i>
                        @(isApproving ? "Approve" : "Reject") Leave Request
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <!-- Balance Summary -->
                    <div class="mb-4">
                        <label class="text-uppercase text-muted small fw-bold letter-spacing-wide d-block mb-3">Employee Balance Status</label>
                        @if (selectedBalance != null)
                        {
                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="p-3 rounded-3 bg-white border shadow-sm">
                                        <small class="text-muted d-block mb-1">@(selectedRequest.LeaveType) (Avail.)</small>
                                        <div class="fw-bold h5 mb-0 text-dark">
                                            @((selectedRequest.LeaveType switch {
                                                "Vacation" => selectedBalance.AnnualLeaveAvailable,
                                                "Sick" => selectedBalance.SickLeaveAvailable,
                                                "Family" => selectedBalance.FamilyLeaveAvailable,
                                                "Parental" => selectedBalance.ParentalLeaveAvailable,
                                                "Maternity" => selectedBalance.MaternityLeaveAvailable,
                                                "Study" => selectedBalance.StudyLeaveAvailable,
                                                "Out" => selectedBalance.OutLeaveAvailable,
                                                _ => 0
                                            })) days
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="p-3 rounded-3 bg-white border shadow-sm">
                                        <small class="text-muted d-block mb-1">Request Length</small>
                                        <div class="fw-bold h5 mb-0 @(IsOverLimit() ? "text-danger" : "text-primary")">@selectedRequest.DurationDays days</div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center p-3">
                                <span class="spinner-border spinner-border-sm text-primary"></span>
                            </div>
                        }
                    </div>

                    <div class="glass-panel p-3 rounded-3 bg-white border border-light shadow-sm mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Employee:</span>
                            <span class="fw-bold small">@selectedRequest.EmployeeName</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Type:</span>
                            <span class="fw-bold small text-primary">@selectedRequest.LeaveType</span>
                        </div>
                        <div class="col-12 mt-3">
                            <label class="small text-muted fw-bold text-uppercase d-block mb-1">Reason</label>
                            <p class="mb-0 bg-light p-3 rounded-2">@(selectedRequest.Reason ?? "No reason provided")</p>
                        </div>

                        @if (!string.IsNullOrEmpty(selectedRequest.AttachmentPath))
                        {
                            <div class="col-12 mt-3">
                                <label class="small text-muted fw-bold text-uppercase d-block mb-1">Supporting Document</label>
                                <a href="@selectedRequest.AttachmentPath" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill">
                                    <i class="bi bi-file-earmark-pdf me-2"></i>View Attachment
                                </a>
                            </div>
                        }
                    </div>

                    <div class="form-group mb-0">
                        <label class="form-label-primary small fw-bold mb-2">Internal Note / Comment</label>
                        <textarea class="form-control form-control-premium" rows="3" @bind="adminComment" placeholder="Reason for @(isApproving ? "approval" : "rejection")..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-white p-4">
                    <button type="button" class="btn btn-light px-4 rounded-pill fw-bold" @onclick="CloseModal">Cancel Action</button>
                    <button type="button" class="btn @(isApproving ? "btn-success" : "btn-danger") px-5 rounded-pill fw-bold shadow-sm transition-all hover-translate-y" @onclick="ProcessReview">
                        Confirm @(isApproving ? "System Approval" : "Rejection")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<LeaveRequest>? requests;
    private Dictionary<string, string> employeeNames = new();
    private bool showModal = false;
    private LeaveRequest? selectedRequest;
    private LeaveBalance? selectedBalance;
    private bool isApproving = false;
    private string adminComment = "";
    private string activeTab = "pending";

    // Calendar state
    private DateTime currentCalendarDate = DateTime.Today;
    private List<DateTime> calendarDays = new();

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAdmin)
        {
            Navigation.NavigateTo("/profile");
            return;
        }

        await LoadData();
        GenerateCalendar();
    }

    private void GenerateCalendar()
    {
        calendarDays.Clear();
        var firstDayOfMonth = new DateTime(currentCalendarDate.Year, currentCalendarDate.Month, 1);
        
        // Adjust to start on Monday (DayOfWeek.Monday = 1)
        int diff = (int)firstDayOfMonth.DayOfWeek - (int)DayOfWeek.Monday;
        if (diff < 0) diff += 7;
        
        var startDate = firstDayOfMonth.AddDays(-diff);
        
        // 6 weeks of days for the grid
        for (int i = 0; i < 42; i++)
        {
            calendarDays.Add(startDate.AddDays(i));
        }
    }

    private async Task LoadData()
    {
        requests = activeTab == "pending" 
            ? await LeaveService.GetPendingLeaveRequestsAsync() 
            : await LeaveService.GetAllLeaveRequestsAsync();

        if (requests != null)
        {
            foreach (var req in requests)
            {
                if (string.IsNullOrEmpty(req.EmployeeName) && !employeeNames.ContainsKey(req.EmployeeId))
                {
                    var emp = await UserService.GetUserByIdAsync(req.EmployeeId);
                    employeeNames[req.EmployeeId] = emp?.Name ?? "Unknown";
                }
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetTab(string tab)
    {
        activeTab = tab;
        requests = null;
        await LoadData();
        if (tab == "calendar") GenerateCalendar();
    }

    private List<LeaveRequest> GetRequestsForDay(DateTime day)
    {
        if (requests == null) return new();
        
        // For calendar, we need all requests (not just pending) to show approved ones too
        return requests.Where(r => 
            day.Date >= r.StartDate.Date && 
            day.Date <= r.EndDate.Date && 
            (r.Status == "Approved" || r.Status == "Pending")).ToList();
    }

    private void PrevMonth() { currentCalendarDate = currentCalendarDate.AddMonths(-1); GenerateCalendar(); }
    private void NextMonth() { currentCalendarDate = currentCalendarDate.AddMonths(1); GenerateCalendar(); }
    private void GoToToday() { currentCalendarDate = DateTime.Today; GenerateCalendar(); }

    private async Task OpenReviewModal(LeaveRequest request, bool approve)
    {
        selectedRequest = request;
        isApproving = approve;
        adminComment = "";
        selectedBalance = null;
        showModal = true;
        
        // Fetch balance for the modal
        selectedBalance = await LeaveService.GetOrCreateLeaveBalanceAsync(request.EmployeeId);
        await InvokeAsync(StateHasChanged);
    }

    private void CloseModal()
    {
        showModal = false;
        selectedRequest = null;
        selectedBalance = null;
    }

    private async Task ProcessReview()
    {
        if (selectedRequest == null) return;

        var status = isApproving ? "Approved" : "Rejected";
        await LeaveService.ReviewLeaveRequestAsync(selectedRequest.Id, status, adminComment, AuthService.CurrentUser?.Name ?? "Admin");
        
        CloseModal();
        await LoadData();
    }

    private bool IsOverLimit()
    {
        if (selectedRequest == null || selectedBalance == null) return false;
        
        var available = selectedRequest.LeaveType switch {
            "Vacation" => selectedBalance.AnnualLeaveAvailable,
            "Sick" => selectedBalance.SickLeaveAvailable,
            "Family" => selectedBalance.FamilyLeaveAvailable,
            "Parental" => selectedBalance.ParentalLeaveAvailable,
            "Maternity" => selectedBalance.MaternityLeaveAvailable,
            "Study" => selectedBalance.StudyLeaveAvailable,
            "Out" => selectedBalance.OutLeaveAvailable,
            _ => 1000
        };
        
        return selectedRequest.DurationDays > available;
    }

    private string GetTypeColor(string type)
    {
        return type switch
        {
            "Vacation" => "#fcd34d",
            "Sick" => "#f87171",
            "Family" => "#60a5fa",
            "Parental" => "#fb7185",
            "Maternity" => "#f472b6",
            "Study" => "#34d399",
            "Out" => "#0ea5e9",
            "Unpaid" => "#94a3b8",
            _ => "#cbd5e1"
        };
    }
}
