@page "/Error"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@using System.Diagnostics
@using Microsoft.AspNetCore.Diagnostics
@using System.IO
@inject IWebHostEnvironment Environment

<PageTitle>System Error - African Ideas</PageTitle>

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-dynamic-mesh py-5 animate-fade-in">
    <div class="row w-100 justify-content-center">
        <div class="col-md-9 col-lg-7 col-xl-6">
            <div class="glass-panel p-0 rounded-4 shadow-lg border-0 overflow-hidden">
                @* Header Bar *@
                <div class="bg-danger p-4 text-white d-flex align-items-center gap-3">
                    <div class="bg-white rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px;">
                        <i class="bi bi-exclamation-octagon-fill text-danger fs-4"></i>
                    </div>
                    <div>
                        <h3 class="mb-0 fw-bold text-white">System Interruption</h3>
                        <p class="mb-0 small opacity-75">An unexpected error has occurred in the application.</p>
                    </div>
                </div>
                
                <div class="p-4 p-md-5">
                    <div class="text-center mb-5">
                        <div class="bi bi-bug-fill text-danger opacity-10 mb-4" style="font-size: 6rem; line-height: 1;"></div>
                        <h4 class="fw-bold text-dark mb-3">Something went wrong</h4>
                        <p class="text-muted">We've encountered a technical difficulty. Our team has been notified and is looking into it.</p>
                    </div>

                    @if (exceptionFeature?.Error != null)
                    {
                        <div class="alert alert-danger border-0 bg-danger bg-opacity-5 rounded-4 p-4 mb-4">
                            <div class="d-flex align-items-start gap-3">
                                <i class="bi bi-info-circle-fill fs-4 text-danger mt-1"></i>
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold mb-1 text-danger">Diagnostic Information</h6>
                                    <p class="mb-0 text-dark small fw-medium">@exceptionFeature.Error.GetType().Name</p>
                                    <p class="mb-0 text-muted small">@exceptionFeature.Error.Message</p>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <button class="btn btn-outline-secondary btn-sm rounded-pill px-3 mb-2 fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#stackTrace" aria-expanded="false" aria-controls="stackTrace">
                                <i class="bi bi-code-slash me-2"></i> Toggle Technical Details
                            </button>
                            <div class="collapse" id="stackTrace">
                                <div class="card border-0 bg-dark text-light p-3 rounded-4 shadow-inner mt-2">
                                    <pre class="small mb-0" style="white-space: pre-wrap; font-family: 'Cascadia Code', 'Consolas', monospace; font-size: 0.75rem; opacity: 0.8;">@exceptionFeature.Error.StackTrace</pre>
                                </div>
                            </div>
                        </div>
                    }

                    @if (ShowRequestId)
                    {
                        <div class="text-center mb-4">
                            <span class="badge bg-light text-muted border px-3 py-2 rounded-pill small">
                                <i class="bi bi-fingerprint me-1"></i> Trace ID: @RequestId
                            </span>
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <a href="/" class="btn btn-primary btn-lg rounded-pill shadow-lg py-3 fw-bold transition-all hover-translate-y">
                            <i class="bi bi-house-door-fill me-2"></i> Return to Safety
                        </a>
                        <button class="btn btn-link text-muted small mt-2" @onclick="ReloadPage">
                            <i class="bi bi-arrow-clockwise me-1"></i> Try reloading the page
                        </button>
                    </div>
                </div>
            </div>
            
            <div class="text-center mt-4 opacity-50">
                <p class="small text-muted mb-0">&copy; @DateTime.Now.Year African Ideas Development. If the problem persists, please contact IT support.</p>
            </div>
        </div>
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [Inject]
    private ILogger<Error>? Logger { get; set; }

    [Inject]
    private NavigationManager? Navigation { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
    private IExceptionHandlerPathFeature? exceptionFeature;

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
        
        if (HttpContext != null)
        {
            exceptionFeature = HttpContext.Features.Get<IExceptionHandlerPathFeature>();
            
            if (exceptionFeature?.Error != null)
            {
                // Auto-log to file for agent inspection
                try 
                {
                    var logPath = Path.Combine(Environment.ContentRootPath, "last_error.txt");
                    var logContent = $"Time: {DateTime.Now}\nRequest ID: {RequestId}\nError: {exceptionFeature.Error.Message}\nStack Trace:\n{exceptionFeature.Error.StackTrace}\n\n";
                    File.WriteAllText(logPath, logContent);
                }
                catch (Exception ex)
                {
                    Logger?.LogError(ex, "Failed to write error log to file");
                }
            }
        }
    }

    private void ReloadPage()
    {
        Navigation?.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
