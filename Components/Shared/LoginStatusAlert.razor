@* Login Status Alert - Reusable success/error alert for login pages *@

@if (!string.IsNullOrEmpty(SuccessMessage))
{
    <div class="alert alert-success border-0 bg-success bg-opacity-10 text-success rounded-4 p-4 mb-4">
        <h5 class="fw-bold"><i class="bi bi-check-circle-fill me-2"></i> @SuccessMessage</h5>
        @if (ShowWelcomeSubtext)
        {
            <p class="mb-0">Identification verified. Welcome back.</p>
        }
    </div>
    @if (ShowContinueButton)
    {
        <div class="mt-3">
            <button type="button" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm" @onclick="OnContinue">
                Continue to Dashboard <i class="bi bi-arrow-right ms-2"></i>
            </button>
        </div>
    }
}

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger rounded-4 p-4 mb-4 shadow-sm animate-shake">
        <div class="d-flex align-items-start gap-3">
            <i class="bi bi-exclamation-triangle-fill fs-4 mt-1"></i>
            <div class="flex-grow-1">
                <h6 class="fw-bold mb-1">Gate Access Problem</h6>
                @((MarkupString)ErrorMessage.Replace("\n", "<br />"))
                
                @if (!string.IsNullOrEmpty(TechnicalError))
                {
                    <div class="mt-3 pt-3 border-top border-danger border-opacity-10">
                        <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none x-small d-flex align-items-center gap-1" @onclick="ToggleDetails">
                            <i class="bi @(showDetails ? "bi-chevron-up" : "bi-chevron-down")"></i>
                            @(showDetails ? "Hide technical diagnostic" : "Show technical diagnostic")
                        </button>
                        
                        @if (showDetails)
                        {
                            <div class="mt-2 p-2 bg-black bg-opacity-5 rounded border border-danger border-opacity-10 font-monospace x-small animate-fade-in" style="white-space: pre-wrap; word-break: break-all;">
                                <div class="fw-bold mb-1 text-uppercase letter-spacing-wide opacity-50">Diagnostic String:</div>
                                @TechnicalError
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? SuccessMessage { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? TechnicalError { get; set; }
    [Parameter] public bool ShowWelcomeSubtext { get; set; }
    [Parameter] public bool ShowContinueButton { get; set; }
    [Parameter] public EventCallback OnContinue { get; set; }

    private bool showDetails = false;

    private void ToggleDetails() => showDetails = !showDetails;
}
