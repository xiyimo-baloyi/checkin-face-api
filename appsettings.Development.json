{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DetailedErrors": true,
  "AzureFaceApi": {
    "Endpoint": "",
    "Key": ""
  },
  "CosmosDb": {
    "AccountEndpoint": "",
    "AccountKey": "",
    "DatabaseName": "FaceApiDb",
    "ContainerName": "Users"
  },
  "ApiSettings": {
    "ApiKey": "dev-key-7712"
  },
  "LoginSettings": {
    "RequireLivenessCheck": false,
    "PoseToleranceDegrees": 20
  },
  "DataStore": {
    "UsersFilePath": "Data/users.json"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "IpWhitelist": ["127.0.0.1", "::1"],
    "EndpointWhitelist": [
      "get:/health",
      "get:/health/ready",
      "get:/health/live"
    ],
    "ClientWhitelist": [],
    "GeneralRules": [
      {
        "Endpoint": "*:/login",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "*:/register",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      }
    ]
  }
}
