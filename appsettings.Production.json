{
  "CircuitOptions": {
    "DetailedErrors": false,
    "DisconnectedCircuitMaxRetained": 1500,
    "DisconnectedCircuitRetentionPeriodMinutes": 10
  },
  "Azure": {
    "SignalR": {
      "ConnectionString": null
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ASPNETCORE_ENVIRONMENT": "Production",
  "ASPNETCORE_LOGGING__CONSOLE__DISABLECOLORS": "true",
  "ASPNETCORE_LOGGING__LOGLEVEL__DEFAULT": "Information",
  "APPLICATIONINSIGHTS_CONNECTION_STRING": "",
  "AzureFaceApi": {
    "Endpoint": "",
    "Key": ""
  },
  "CosmosDb": {
    "AccountEndpoint": "",
    "AccountKey": "",
    "DatabaseName": "FaceApiDb",
    "ContainerName": "Users"
  },
  "LoginSettings": {
    "RequireLivenessCheck": false,
    "PoseToleranceDegrees": 20
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "IpWhitelist": [],
    "EndpointWhitelist": [ "get:/health", "get:/health/ready", "get:/health/live" ],
    "ClientWhitelist": [],
    "GeneralRules": [
      {
        "Endpoint": "*:/login",
        "Period": "1m",
        "Limit": 5
      },
      {
        "Endpoint": "*:/register",
        "Period": "1m",
        "Limit": 3
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 60
      }
    ]
  }
}
